{
  "base_generation_human_tokens": 10,
  "candidate_source": "frozen_rescue_candidate_manifest",
  "feasibility_lower_bound": "max(0,remaining_human_tokens-maximum_generation_human_tokens*future_generation_count)",
  "feasibility_upper_bound": "min(maximum_generation_human_tokens,remaining_human_tokens)",
  "final_spend_rule": "clamp(desired_spend,feasibility_lower_bound,feasibility_upper_bound)",
  "fully_missing_monitoring_behavior": {
    "selection": "seeded_random_candidate_order",
    "spending_human_tokens": 10
  },
  "horizon": 10,
  "insufficient_candidates_behavior": "select_the_largest_feasible_subset_and_record_unspent_tokens",
  "lifetime_human_tokens": 100,
  "maximum_generation_human_tokens": 20,
  "monitoring_lag_generations": 1,
  "name": "joint",
  "nonfinite_score_behavior": "reject_allocation_as_invalid",
  "partially_missing_mode_behavior": "assign_score_zero",
  "policy_version": "week2-fixture-v1",
  "ranking_rule": "descending_undercoverage_score",
  "real_run_blocker": "Real-model execution is blocked until the team approves a tokenizer-counted real human-token budget and total optimizer-token budget.",
  "schema_version": "1.0",
  "score_formula": "clip((previous_generation_mode_nll-reference_mode_nll)/max(abs(reference_mode_nll),1e-8),0,1)",
  "score_name": "lagged_relative_mode_nll_gap",
  "spending_rule": {
    "urgency_0_25_to_below_0_50": 10,
    "urgency_at_least_0_50": 20,
    "urgency_below_0_25": 0
  },
  "status": "fixture_frozen_real_run_blocked",
  "tie_breaking": "ascending_example_id",
  "token_granularity": 10,
  "urgency_summary": "maximum_finite_mode_score",
  "uses_mode_undercoverage": true
}
