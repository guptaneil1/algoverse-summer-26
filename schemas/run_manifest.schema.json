{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/human-data-budget/run_manifest.schema.json",
  "title": "Human Data Budget run manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "stage", "git_commit", "model", "data", "policy", "budget", "randomness", "environment", "horizon", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["fixture", "positive_control", "screening", "pilot", "confirmation"]},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_tree_clean": {"type": "boolean"},
    "model": {
      "type": "object",
      "required": ["identifier", "revision", "tokenizer_revision"],
      "properties": {
        "identifier": {"type": "string"},
        "revision": {"type": "string"},
        "tokenizer_revision": {"type": "string"}
      }
    },
    "data": {
      "type": "object",
      "required": ["train_manifest", "train_manifest_sha256"],
      "properties": {
        "train_manifest": {"type": "string"},
        "train_manifest_sha256": {"type": "string"},
        "partitions": {
          "description": "Per-example provenance per data partition. Absent when the run declared no provenance source, in which case validation/audit.py classifies the run invalid with SEPARATION_MISSING_PROVENANCE. Partition names are the vocabulary used by validation/audit.py and docs/evaluation/week3_data_evaluation_appendix.md; see docs/interfaces/run_manifest.md for the translation from data/manifest.py.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_human_train": {"$ref": "#/$defs/partitionExamples"},
            "rescue_candidates": {"$ref": "#/$defs/partitionExamples"},
            "generation_prompts": {"$ref": "#/$defs/partitionExamples"},
            "validation": {"$ref": "#/$defs/partitionExamples"},
            "final_human_test": {"$ref": "#/$defs/partitionExamples"}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["name", "config", "config_sha256"]
    },
    "budget": {
      "type": "object",
      "required": ["lifetime_human_optimizer_tokens", "total_optimizer_tokens"],
      "properties": {
        "lifetime_human_optimizer_tokens": {"type": "integer", "minimum": 0},
        "total_optimizer_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "randomness": {
      "type": "object",
      "required": ["chain_seed"]
    },
    "environment": {"type": "object"},
    "horizon": {"type": "integer", "minimum": 1},
    "status": {"enum": ["planned", "running", "complete", "failed", "invalid"]}
  },
  "$defs": {
    "partitionExamples": {
      "description": "One record per example. Every field is required: validation/audit.py treats a missing one as invalidating (SEPARATION_MISSING_PROVENANCE, or SEPARATION_MISSING_ID when stable_id is absent).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stable_id", "content_hash", "source_dataset", "origin"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "source_dataset": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
