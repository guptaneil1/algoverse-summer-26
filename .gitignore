# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# Build-time corpus download for scripts/build_wikitext103_manifests.py.
# ~300 MB of parquet, two files over GitHub's 100 MB limit. The manifests it
# produces are committed; the corpus it reads never is (data/README.md).
.cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local configuration and credentials
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Experiment trackers and logs
# Anchored with a leading slash: an unanchored `runs/` matches at every depth, so
# it also swallowed `docs/runs/`, where the Week 3 reference-run index lives. The
# committed index survived only because it was added before the rule; any new
# file under docs/runs/ was silently ignored.
wandb/
logs/
/runs/
external/

# Large model artifacts
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors

# Data: keep documentation and manifests only
data/*
!data/README.md
!data/datasheet.md
!data/manifests/
data/manifests/*
!data/manifests/README.md
# The frozen partition manifests are the scientific artifact, not build output:
# PROTOCOL.md section 3 requires stable IDs and content hashes to be immutable
# inputs to analysis, and a reproduction cannot verify partitions it cannot read.
# They are text-free by construction (data/README.md), so committing them
# publishes hashes and token counts, never corpus bytes. ~6.5 MB total.
!data/manifests/*.jsonl
!data/manifests/MANIFEST_HASHES.json
!data/fixtures/
data/fixtures/*
!data/fixtures/toy_corpus.jsonl
# Toy partition fixtures backing the smoke chain's data.partitions provenance
# block. Without these the toy run cannot emit provenance and the validator
# classifies it invalid, so they are committed like toy_corpus.jsonl above.
!data/fixtures/partitions/
!data/fixtures/partitions/*.jsonl
!data/fixtures/partitions/README.md

# Results: keep documentation and small generated aggregates only
results/*
!results/README.md
!results/aggregates/
results/aggregates/*
!results/aggregates/README.md
# Small generated aggregates ARE tracked — results/README.md: "Git contains only
# small validated aggregates, generated tables/figures, and documentation."
!results/aggregates/*.json
!results/figures/
results/figures/*
!results/figures/README.md
# Generated figures and their provenance/hash record are tracked for the same
# reason. Without these negations `make figures` produces output that can never
# be committed, and PROTOCOL.md §3's requirement that figures carry content
# hashes becomes unverifiable by anyone else.
!results/figures/*.png
!results/figures/figure_provenance.json
# Generated LaTeX tables and their provenance record.
!results/tables/
results/tables/*
!results/tables/README.md
!results/tables/*.tex
!results/tables/table_provenance.json
# Analysis-ready CSV exports. Small, generated, and the format reviewers open first.
!results/csv/
results/csv/*
!results/csv/README.md
!results/csv/*.csv
# Top-level generated reports and the combined artifact hash manifest.
!results/policy_behavior_report.md
!results/ARTIFACT_MANIFEST.json

# Temporary and generated files
tmp/
cache/
dist/
*.log
*.tmp

# LaTeX build outputs
# Generated figures must not enter the manuscript tree while inputs are
# simulated. generate_figures.py no longer mirrors here, and a test enforces it;
# this is the belt-and-braces layer. When real figures are promoted at a results
# freeze, negate them individually so the promotion is a deliberate act.
paper/figures/*.png
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.pdf

# Claude Code personal overrides
.claude/settings.local.json
